# Copy to .env and fill in the values for your own Azure resources.
# No keys or secrets belong in here: every service in this repo authenticates
# with Entra ID via AzureDeveloperCliCredential (run `azd auth login` first).

# ---------------------------------------------------------------------------
# Azure subscription (used by the PostgreSQL control-plane calls)
# ---------------------------------------------------------------------------
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=rg-ai-databases-demos

# ---------------------------------------------------------------------------
# Microsoft Foundry
# Three different endpoint shapes are needed, they are not interchangeable:
#   MODELS   - Azure AI inference SDK (the notebook's embedding client)
#   SERVICES - Foundry project endpoint (the agent / chat client)
#   OPENAI   - Azure OpenAI form, required by the Postgres azure_ai extension
# ---------------------------------------------------------------------------
FOUNDRY_MODELS_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/models
FOUNDRY_SERVICES_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
FOUNDRY_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com

# Model *deployment* names, not model names
FOUNDRY_CHAT_MODEL=gpt-4o-mini
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-large
FOUNDRY_EMBEDDING_SMALL_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Azure Cosmos DB for NoSQL
# ---------------------------------------------------------------------------
COSMOS_DB_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_DB_DATABASE=ops-db
COSMOS_DB_CONTAINER=tickets

# ---------------------------------------------------------------------------
# Azure Database for PostgreSQL flexible server
# ---------------------------------------------------------------------------
POSTGRES_HOST=<your-postgres-server>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=ops-db
POSTGRES_TABLE=tickets
